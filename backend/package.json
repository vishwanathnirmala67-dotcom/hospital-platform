{
  "name": "hospital-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic appointment & e-prescription API",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "generate-raw": "node scripts/generate-raw.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:unit": "node --test \"tests/cleaning.test.js\" \"tests/metrics.test.js\" \"tests/validation.test.js\" \"tests/tokens.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.13"
  }
}
