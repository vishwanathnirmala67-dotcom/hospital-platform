# Copy to .env for local dev. NEVER commit .env (it is git-ignored).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hospital
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# Optional SMTP for email notifications; without it emails are written to the log.
SMTP_URL=
MAIL_FROM=no-reply@clinic.example
# Used only by `npm run seed` to create the first admin
SEED_ADMIN_EMAIL=admin@clinic.example
SEED_ADMIN_PASSWORD=ChangeMe#2026
